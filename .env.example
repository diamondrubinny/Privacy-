# PrivacyScan IL — example environment. Copy to .env and adjust. Never commit real secrets.

NODE_ENV=development

# --- Scanner (apps/worker) ---
# Optional: absolute path to a Chromium binary. Leave empty to use Playwright's bundled browser.
SCANNER_CHROMIUM_EXECUTABLE_PATH=
# Public page explaining the scanner bot; appended to the User-Agent.
SCANNER_BOT_INFO_URL=https://example.com/scanner-bot
# Navigation timeout per page load (ms).
SCANNER_NAV_TIMEOUT_MS=30000
# Time to wait after load / consent click for late trackers (ms).
SCANNER_SETTLE_MS=5000
# Cap on recorded requests per browser mode (evidence is marked "truncated" beyond it).
SCANNER_MAX_REQUESTS_PER_MODE=2000
# Optional upstream HTTP proxy for outbound traffic (e.g. corporate network). Empty = direct.
# Target addresses are still validated locally before forwarding.
SCANNER_UPSTREAM_PROXY=
# DANGER: allows scanning private/loopback addresses. Test environments only.
# Refused at startup when NODE_ENV=production.
SCANNER_UNSAFE_ALLOW_PRIVATE_NETWORKS=false
# DANGER: ignores TLS certificate errors (only for TLS-intercepting dev proxies).
# Refused at startup when NODE_ENV=production.
SCANNER_UNSAFE_IGNORE_HTTPS_ERRORS=false

# --- Infrastructure (docker-compose; used from phase 3; S3 from phase 4) ---
POSTGRES_USER=privacyscan
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=privacyscan
DATABASE_URL=postgresql://privacyscan:change-me-local-only@localhost:5432/privacyscan
REDIS_URL=redis://localhost:6379
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=privacyscan-evidence
S3_ACCESS_KEY=change-me-local-only
S3_SECRET_KEY=change-me-local-only
